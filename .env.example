# Wilo Water Pump Automation System - Environment Configuration
# =============================================================

# Flask Backend API Port
FLASK_PORT=5050

# React Dashboard Port (Vite)
DASHBOARD_PORT=8080

# Next.js Frontend Port
FRONTEND_PORT=3000

# SQLite Database Location
DATABASE_URL=sqlite:///data/wilo_system.db

# Hardware Serial Port (Optional - e.g. COM3 or /dev/ttyUSB0; leaves empty for simulation)
SERIAL_PORT=

# ML Prediction Settings
FALLBACK_START_HOUR=7.0
FALLBACK_DURATION=90
